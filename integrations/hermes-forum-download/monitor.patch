+def forum_download_enabled():
+    """Only use the button sender after the independent plugin is enabled."""
+    import yaml
+    config_path = Path.home() / ".hermes" / "config.yaml"
+    try:
+        config = yaml.safe_load(config_path.read_text(encoding="utf-8")) or {}
+    except (OSError, yaml.YAMLError):
+        return False
+    plugins = config.get("plugins") or {}
+    return "forum-download" in (plugins.get("enabled") or []) and "forum-download" not in (plugins.get("disabled") or [])
